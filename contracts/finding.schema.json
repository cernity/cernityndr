{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homelabai/ndr/contracts/finding.schema.json",
  "title": "finding",
  "description": "Origin: v2 §17. Owned by the finding service (U9). `state` is the canonical lifecycle machine; an unknown state is rejected. A failed enrichment must never erase a valid first-stage finding — ENRICHMENT_FAILED is a terminal-eligible state, not a drop.",
  "type": "object",
  "additionalProperties": false,
  "required": ["finding_id", "tenant_id", "detector_id", "detector_version", "category", "severity", "confidence", "first_seen", "last_seen", "state"],
  "properties": {
    "finding_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "sensor_ids": { "type": "array", "items": { "type": "string" } },
    "detector_id": { "type": "string", "minLength": 1 },
    "detector_version": { "type": "string" },
    "category": { "type": "string" },
    "severity": { "type": "integer", "minimum": 1, "maximum": 10 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "first_seen": { "type": "string", "format": "date-time" },
    "last_seen": { "type": "string", "format": "date-time" },
    "entities": {
      "description": "Typed entity objects (ip/domain/fingerprint/…). Detectors emit this as a JSON-serialized string on the wire (parsed by downstream consumers and the ClickHouse/SIEM boundary); the raw array form is also accepted.",
      "type": ["array", "string"],
      "items": { "type": "object" }
    },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "mitre": {
      "type": "array",
      "description": "MITRE ATT&CK mapping when defensible (v2 §17).",
      "items": { "type": "string" }
    },
    "state": {
      "type": "string",
      "description": "Canonical lifecycle (v2 §17).",
      "enum": ["CANDIDATE", "SCORED", "CAPTURE_REQUESTED", "ENRICHED", "ENRICHMENT_FAILED", "SUPPRESSED", "FINAL", "DEVO_QUEUED", "DEVO_SENT"]
    },
    "enrichment_state": {
      "type": "string",
      "enum": ["NOT_REQUIRED", "REQUIRED", "ENRICHED", "ENRICHMENT_FAILED"]
    },
    "capture_job_ids": { "type": "array", "items": { "type": "string" } },
    "suppression_reason": { "type": "string" },
    "devo_delivery_state": {
      "type": "string",
      "description": "SIEM (Devo-analog / ES) delivery tracking.",
      "enum": ["NONE", "QUEUED", "SENT"]
    }
  }
}
