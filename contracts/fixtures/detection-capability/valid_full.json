      "description": "Does not attribute tunnels to a specific C2 family; family labelling is unverified.",
      "claim": "T1568.002",
      "unverified": true
    },
    { "description": "Entropy heuristic misses low-entropy base32 tunnels." }
  ],
  "backing_tests": {
    "golden_pcap": ["pcap/dns-tunnel-iodine.pcap"],
    "benign_control": ["pcap/benign-dns-cdn.pcap"],
    "performance": ["bench/dns-10k-qps.json"]
  },
  "first_supported_version": "1.1.0"
}
