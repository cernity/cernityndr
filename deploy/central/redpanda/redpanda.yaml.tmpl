# Redpanda config template for the SECURE bus. The entrypoint envsubst's
# ${CERNITY_ADVERTISE_HOST} then starts redpanda with this file. Internal listener
# (9092) stays plaintext on the private docker net; external (19092) requires
# SASL/SCRAM-SHA-512 over TLS. The SCRAM superuser is seeded via RP_BOOTSTRAP_USER.
# NOTE: Redpanda config keys are version-sensitive — validate against the running
# redpandadata/redpanda:latest on the test env (plan U2 is deploy-verified).
redpanda:
  data_directory: /var/lib/redpanda/data
  node_id: 0
  empty_seed_starts_cluster: true
  seed_servers: []

  rpc_server:
    address: 0.0.0.0
    port: 33145
  advertised_rpc_api:
    address: redpanda
    port: 33145
  admin:
    - address: 0.0.0.0
      port: 9644

  kafka_api:
    - name: internal
      address: 0.0.0.0
      port: 9092
    - name: external
      address: 0.0.0.0
      port: 19092
      authentication_method: sasl

  advertised_kafka_api:
    - name: internal
      address: redpanda
      port: 9092
    - name: external
      address: ${CERNITY_ADVERTISE_HOST}
      port: 19092

  kafka_api_tls:
    - name: external
      enabled: true
      cert_file: /certs/broker.crt
      key_file: /certs/broker.key
      truststore_file: /certs/ca.crt
      require_client_auth: false
