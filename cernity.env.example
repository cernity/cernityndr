# Cernity configuration — copy to `.env` and edit:  cp cernity.env.example .env
# Every user-definable setting lives here. The compose files read these values
# (falling back to the defaults shown if a line is left commented out), so this
# one file is all you need to touch for a normal deployment.
#
# Run the stack from the repo root so Docker Compose auto-loads `.env`, e.g.:
#   docker compose -f deploy/quickstart/docker-compose.yml up

# ─── Message bus ─────────────────────────────────────────────────────────────
# Where the detectors reach the Kafka/Redpanda bus.
REDPANDA_BOOTSTRAP=redpanda:9092
# This host's reachable IP/DNS, advertised on the external listener (port 19092) so a
# remote Suricata sensor's shipper can connect. Set to the Cernity host's LAN IP/DNS.
CERNITY_ADVERTISE_HOST=127.0.0.1

# ─── Bus security (external listener :19092) ─────────────────────────────────
# The external listener is SASL/SCRAM-SHA-512 over TLS by DEFAULT. Generate certs +
# a SCRAM credential with:  ./deploy/security/gen-bus-certs.sh  (see deploy/security).
# The internal listener (redpanda:9092) stays plaintext on the private Docker net;
# central services need no credentials.
#CERNITY_INSECURE_BUS=1              # DEMO ONLY — drops the external listener to plaintext (warns loudly)
#CERNITY_BUS_USER=cernity-sensor     # SCRAM username (central + sensor)
#CERNITY_BUS_PASSWORD=               # SCRAM password (from gen-bus-certs.sh)
# On a remote SENSOR, the Fluent Bit shipper authenticates with:
#CERNITY_BUS_SASL=1
#CERNITY_BUS_TLS_CA=/certs/ca.crt    # the ca.crt copied from the central host
# A Cernity CLIENT pointed at a secured external broker (shared/ndr_runtime) uses:
#NDR_BUS_SASL_MECHANISM=SCRAM-SHA-512
#NDR_BUS_SASL_USER=cernity-sensor
#NDR_BUS_SASL_PASSWORD=
#NDR_BUS_TLS_CA=/certs/ca.crt

# ─── Identity ────────────────────────────────────────────────────────────────
# Tenant label stamped on state keys and findings (use one per site/customer).
NDR_TENANT=default
# Sensor identifier reported on findings.
NDR_SENSOR=sensor-1

# ─── Detector state ──────────────────────────────────────────────────────────
# Replay a specific EVE fixture through the quickstart feeder (demo/testing). E.g.
# fixtures/east-west-eve.jsonl trips the AD/east-west detectors on a network with no
# real east-west traffic. See tools/eve-feeder/fixtures/README.md.
#CERNITY_FEED_FIXTURE=fixtures/beacon-eve.jsonl

# ─── Detector state ──────────────────────────────────────────────────────────
# memory = in-process (single replica, demos). redis = shared, survives restarts
# and scales to N replicas.
NDR_STATE_BACKEND=memory
NDR_REDIS_URL=redis://redis:6379/0
# Rolling window and re-score cadence, in seconds.
WINDOW_SECS=600
EVAL_SECS=30

# ─── Findings output (findings-forwarder) ────────────────────────────────────
# Where final findings are delivered. One sink, or a comma-list to fan out to
# several at once (a failure in one never blocks the others). See
# docs/siem-integrations.md for the full per-SIEM recipe.
#   file | elasticsearch | opensearch | splunk | webhook | syslog | devo
CERNITY_SINK=file
CERNITY_SINK_FILE=/out/findings.jsonl

# Elasticsearch / OpenSearch
#ES_ENDPOINT=https://siem:9200
#ES_USER=elastic
#ES_PASSWORD=
#ES_TLS_VERIFY=true            # false for an internal/self-signed CA
#ES_INDEX_PREFIX=ndr-findings

# Splunk HEC
#SPLUNK_HEC_URL=https://splunk:8088/services/collector
#SPLUNK_HEC_TOKEN=
#SPLUNK_TLS_VERIFY=true

# Generic webhook (Slack, ticketing, SOAR, custom)
#WEBHOOK_URL=https://example/hook
#WEBHOOK_AUTH=Bearer xxxxx     # optional Authorization header value

# Syslog / CEF (QRadar, ArcSight, most on-prem)
#SYSLOG_HOST=siem
#SYSLOG_PORT=514
#SYSLOG_TLS=false

# Devo — DEVO_TRANSPORT=syslog (mutual-TLS relay) or http (ingestion API)
#DEVO_TRANSPORT=syslog
#DEVO_FORMAT=json              # json | cef
#DEVO_TAG=my.app.cernity.findings
#   syslog transport:
#DEVO_RELAY=relay.devo
#DEVO_PORT=443
#DEVO_CERT=/certs/devo.crt
#DEVO_KEY=/certs/devo.key
#DEVO_CHAIN=/certs/chain.crt
#   http transport:
#DEVO_ENDPOINT=https://intake.devo/event
#DEVO_TOKEN=

# ─── ClickHouse (optional) ───────────────────────────────────────────────────
# Raw-telemetry / findings retention for hunting. Leave CLICKHOUSE_PASSWORD unset
# to run without ClickHouse (findings still flow to the bus and your SIEM).
#CLICKHOUSE_HOST=clickhouse
#CLICKHOUSE_USER=ndr
#CLICKHOUSE_PASSWORD=

# ─── Logging (see docs/logging.md) ───────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR. INFO shows startup + each detection/forward.
LOG_LEVEL=INFO
# json (machine-parseable, default) | text (human-readable for docker logs)
LOG_FORMAT=json
# seconds between per-service "alive" heartbeat log lines
HEARTBEAT_SECS=300
# port for each service's /healthz /readyz /metrics
NDR_METRICS_PORT=9108

# ─── Finding enrichment ──────────────────────────────────────────────────────
# Tier 1 (offline, always on when the DBs are present) — GeoIP + ASN on external
# IPs. Mount MaxMind GeoLite2 DBs and point these at them; unset => enrichment off.
#GEOIP_DB=/geoip/GeoLite2-Country.mmdb    # Country or City .mmdb (either works)
#GEOIP_ASN_DB=/geoip/GeoLite2-ASN.mmdb
#
# Tier 2 (opt-in) — see docs/enrichment.md for sign-up + key steps.
#INTEL_RDNS=1                  # reverse-DNS (PTR) on external IPs; no key, local resolver
#INTEL_RDAP=1                  # domain registration age + newly-registered-domain flag (RDAP; no key)
#INTEL_NRD_DAYS=30             # a domain younger than this is flagged nrd=true
#INTEL_FP_MAP=/intel/fingerprints.json    # JA3/JA4 -> known-tool name map (operator-populated)
#GREYNOISE_API_KEY=           # optional IP reputation (benign/malicious scanner); free tier available
#VIRUSTOTAL_API_KEY=          # optional IP reputation (VT last-analysis stats); free tier 4 req/min
#INTEL_HTTP_TIMEOUT=3         # seconds per online lookup (best-effort; failures are skipped)

# Known-C2 TLS server-fingerprint blocklist (threat-intel). A local file, one
# JA3S/JA4S/JARM per line (# comments ok) — your own list of malware-tool
# fingerprints (Cobalt Strike, Sliver…). Unset => the c2-fingerprint match is off.
#C2_FP_LIST=/intel/c2-fingerprints.txt

# ─── ML detection (SLIPS overlay, opt-in — see docs/ml-detection.md) ──────────
# Active only when you add `-f deploy/overlays/slips.yml`. SLIPS is the ML leg
# over the same Suricata telemetry; its verdicts arrive as findings tagged
# detector_id=slips_ml. Needs ~8 GB RAM on the central host.
#EVE_BRIDGE_TOPICS=suricata.flow.v1,suricata.raw.v1   # which EVE topics to feed SLIPS
# Detector ids that count as the ML side when correlation-service looks for
# ML×heuristic agreement (a corroboration finding). Comma list; add future ML
# detectors here.
#CORROBORATION_ML_SOURCES=slips_ml
